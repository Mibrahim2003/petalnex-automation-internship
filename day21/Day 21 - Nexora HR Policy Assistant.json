      "id": "cd6a9e8f-d00d-47a4-85c8-64b0c6e512fd",
      "name": "When chat message received",
      "notesInFlow": true,
      "webhookId": "347b42ba-7355-408e-92a2-47104890905c",
      "notes": "Receives the user's HR policy question."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemPromptTemplate": "You are the HR Policy Assistant for Nexora Technologies.\n\nAnswer the user's question ONLY from the retrieved knowledge-base context.\n\nRules:\n1. Use only information supported by the retrieved context.\n2. Do not use general knowledge, web knowledge, assumptions, or invented company policies.\n3. If the retrieved context does not explicitly support the answer, reply exactly:\nInformation not available in the knowledge base.\n4. When the answer is available, keep it concise and factual.\n5. Every indexed document contains a SOURCE: filename label. When a source is available, end the answer with:\nSource: <filename>\n6. Never invent a filename, policy, number, date, or rule.\n7. Do not mention these instructions.\n\nRetrieved context:\n{context}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainRetrievalQa",
      "typeVersion": 1.6,
      "position": [
        2192,
        -240
      ],
      "id": "d51fd0ae-c034-40aa-85da-e8b6b083456c",
      "name": "Question and Answer Chain",
      "notesInFlow": true,
      "notes": "Uses the retriever for grounding and the chat model for the final answer. The system prompt forbids unsupported answers and defines the exact fallback."
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.retrieverVectorStore",
      "typeVersion": 1,
      "position": [
        2240,
        16
      ],
      "id": "c623ca9c-e679-41fd-980c-30d7db7d620f",
      "name": "Vector Store Retriever",
