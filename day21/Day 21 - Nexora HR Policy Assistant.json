                "value": "={{ $json.source_file_id }}"
              },
              {
                "name": "source_url",
                "value": "={{ $json.source_url }}"
              },
              {
                "name": "document_type",
                "value": "={{ $json.document_type }}"
              },
              {
                "name": "knowledge_base",
                "value": "={{ $json.knowledge_base }}"
              }
            ]
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1728,
        192
      ],
      "id": "27def22c-10fd-4dc8-9efc-b4e92e4ed04c",
      "name": "Default Data Loader",
      "notesInFlow": true,
      "notes": "Converts the cleaned text into LangChain Documents and applies the source metadata."
    },
    {
      "parameters": {
        "chunkOverlap": 200,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
