            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "id": "1a49f1c8-82d0-4628-b107-806ca25ddb94",
      "name": "CONFIG - Google Drive Folder ID",
      "notesInFlow": true,
      "notes": "Replace the placeholder with the Google Drive folder ID that contains the HR policy PDFs."
    },
    {
      "parameters": {
        "resource": "fileFolder",
