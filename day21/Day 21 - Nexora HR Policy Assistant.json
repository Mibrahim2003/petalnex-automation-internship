        "options": {
          "fields": [
            "id",
            "name",
            "mimeType",
            "webViewLink"
          ]
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        480,
        0
      ],
      "id": "e8ffccdf-96f4-4f07-ae3d-6a82979b5cac",
      "name": "Google Drive - Find HR Policy PDFs",
      "notesInFlow": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "4WtDND7iObMP2Kkc",
          "name": "Google Drive account"
        }
      },
      "notes": "Finds every PDF in the configured Google Drive folder. The workflow is cloud-safe; no local filesystem node is used."
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "binaryPropertyName": "data"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        720,
        0
      ],
      "id": "28d214eb-2012-42e1-981e-5432c69a142f",
      "name": "Google Drive - Download PDF",
      "notesInFlow": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "4WtDND7iObMP2Kkc",
          "name": "Google Drive account"
        }
      },
      "notes": "Downloads each matching PDF as binary data in the data property."
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        960,
        0
      ],
      "id": "0d501a45-e93d-4f56-9129-4ae7816ff862",
      "name": "Extract Content - PDF",
      "notesInFlow": true,
      "notes": "Extracts readable text from each downloaded PDF."
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.text ?? '');\n\nconst cleaned = raw\n  .replace(/-\\n(?=\\S)/g, '')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .split('\\n')\n  .map(line => line.trim())\n  .join('\\n')\n  .trim();\n\nif (!cleaned) {\n  throw new Error('No text was extracted from the PDF.');\n}\n\nconst sourceFileName =\n  $binary?.data?.fileName ??\n  $json.name ??\n  'Unknown HR policy PDF';\n\nconst sourceFileId =\n  $json.id ??\n  '';\n\nconst sourceUrl =\n  $json.webViewLink ??\n  '';\n\nreturn [{\n  json: {\n    text: `SOURCE: ${sourceFileName}\\n\\n${cleaned}`,\n    source_file_name: sourceFileName,\n    source_file_id: sourceFileId,\n    source_url: sourceUrl,\n    document_type: 'pdf',\n    knowledge_base: 'Nexora Technologies HR Policies'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "id": "b517c258-298a-4788-9414-7145ef3f340e",
      "name": "Clean Content + Source Metadata",
      "notesInFlow": true,
      "notes": "Normalizes PDF text and prepends the source filename so the final assistant can cite the source without inventing it."
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "mode": "list",
          "value": "documents",
          "cachedResultName": "documents"
        },
        "options": {
          "queryName": "match_documents"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.1,
      "position": [
        1488,
        0
      ],
      "id": "199970c3-b0d0-41ee-a79c-d0c5a0e459c0",
      "name": "Supabase Vector Store - Insert",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "L9t07vJynIu3840s",
          "name": "Supabase account"
        }
      },
      "notes": "Inserts chunked documents into the existing documents table. Keep the embedding model/dimension consistent with the table used in Day 20."
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "custom",
        "options": {
