        1728,
        400
      ],
      "id": "b2279aab-e0b1-4ade-a8a2-30f3c70a6de7",
      "name": "Recursive Character Text Splitter",
      "notesInFlow": true,
      "notes": "Splits each policy into approximately 1000-character chunks with 200-character overlap."
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
