      "name": "Google Gemini Chat Model",
      "notesInFlow": true,
      "credentials": {
        "googlePalmApi": {
          "id": "1EgU3ai4PuLycEmH",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "notes": "Generates the final answer from retrieved context only."
    },
    {
