            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -480,
        304
      ],
      "id": "e460457e-7e81-49a4-9889-45b48bd9bc6e",
      "name": "CONFIG - PDF File ID",
      "notesInFlow": true,
      "notes": "Google Drive file ID for the single 40-page PDF used as the knowledge base."
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.fileId }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -240,
        304
      ],
      "id": "f7ce3513-257c-4415-a540-da81d4e98973",
      "name": "Google Drive - Download PDF",
      "notesInFlow": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "4WtDND7iObMP2Kkc",
          "name": "Google Drive account"
        }
      },
      "notes": "Downloads the PDF from Google Drive as binary data. Attach your Google Drive OAuth credential to this node."
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        0,
        304
      ],
      "id": "17d2fd35-6880-4408-b40f-0827523df582",
      "name": "Extract Content - PDF",
      "notesInFlow": true,
      "notes": "Extracts readable text from the downloaded PDF. The binary input field is data."
    },
    {
      "parameters": {
        "jsCode": "const text = String($json.text ?? '')\n  .replace(/-\\n(?=\\S)/g, '')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .split('\\n')\n  .map(line => line.trim())\n  .join('\\n')\n  .trim();\n\nif (!text) {\n  throw new Error('No text was extracted from the PDF.');\n}\n\nreturn [{\n  json: {\n    ...$json,\n    text,\n    source: 'Google Drive PDF',\n    document_type: 'pdf',\n    knowledge_base: 'Day 20 - Document Ingestion',\n    source_file_id: $('CONFIG - PDF File ID').item.json.fileId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        304
      ],
      "id": "0577d27f-809e-4eb4-823c-c4cb2f8c2492",
      "name": "Clean Content",
      "notesInFlow": true,
      "notes": "Normalizes whitespace and PDF line-break artifacts while retaining the extracted text."
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "mode": "list",
          "value": "documents",
          "cachedResultName": "documents"
        },
        "options": {
          "queryName": "match_documents"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.1,
      "position": [
        528,
        304
      ],
      "id": "2d28abaf-3c08-4ccc-8183-98336fbdf7cb",
      "name": "Supabase Vector Store - Insert",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "L9t07vJynIu3840s",
          "name": "Supabase account"
        }
      },
      "notes": "Main vector-store node. It receives the cleaned text on the main connection and uses the attached Document Loader and Embeddings sub-nodes to create and store vectors. Attach your Supabase credential. The documents table and match_documents function must exist in Supabase."
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source_file_id",
                "value": "={{ $json.source_file_id }}"
              },
              {
                "name": "document_type",
                "value": "={{ $json.document_type }}"
              },
              {
                "name": "knowledge_base",
                "value": "={{ $json.knowledge_base }}"
              }
            ]
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        768,
        480
      ],
      "id": "cdc90b3c-eeb8-4577-b852-3dcbcd172de6",
      "name": "Default Data Loader",
      "notesInFlow": true,
      "notes": "LangChain sub-node. It converts the cleaned text into a Document object and passes it to Supabase. It uses the Recursive Character Text Splitter attached below."
    },
    {
      "parameters": {
        "chunkOverlap": 200,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        768,
        688
      ],
      "id": "9e03516e-d7cf-4410-950f-23693afe3a47",
      "name": "Recursive Character Text Splitter",
      "notesInFlow": true,
      "notes": "LangChain sub-node. Splits the document into overlapping chunks of about 1000 characters with 200 characters of overlap."
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        528,
        608
      ],
      "id": "060562fe-17ea-4ab2-8545-beceff748690",
      "name": "Embeddings Google Gemini",
      "credentials": {
        "googlePalmApi": {
          "id": "1EgU3ai4PuLycEmH",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    }
