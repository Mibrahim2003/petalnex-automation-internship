    {
      "parameters": {
        "jsCode": "\n// Eligibility thresholds — tweak these to change the rules\nconst SHORTLIST_MIN_CGPA = 3.0;   // >= this => Shortlisted\nconst REVIEW_MIN_CGPA = 2.5;      // >= this (but below shortlist) => Needs Review\n\nconst items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const row = item.json || {};\n\n  const name = (row.Name ?? row.name ?? '').toString().trim();\n  const email = (row.Email ?? row.email ?? '').toString().trim();\n  const degree = (row.Degree ?? row.degree ?? '').toString().trim();\n\n  // Normalize CGPA: strip anything that is not a digit or a dot\n  const cgpaRaw = (row.CGPA ?? row.cgpa ?? row.Cgpa ?? '').toString();\n  const cgpa = parseFloat(cgpaRaw.replace(/[^0-9.]/g, ''));\n\n  const emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n  let status;\n  let notes;\n  let valid = true;\n\n  // --- Validation ---\n  if (!name || !email || !emailValid || isNaN(cgpa)) {\n    valid = false;\n    status = 'Needs Review';\n    notes = 'Missing/invalid data (name, email, or CGPA).';\n  // --- Eligibility conditions -> Categorization ---\n  } else if (cgpa >= SHORTLIST_MIN_CGPA) {\n    status = 'Shortlisted';\n    notes = 'Meets CGPA threshold (>= ' + SHORTLIST_MIN_CGPA + ').';\n  } else if (cgpa >= REVIEW_MIN_CGPA) {\n    status = 'Needs Review';\n    notes = 'Borderline CGPA (' + REVIEW_MIN_CGPA + ' - ' + (SHORTLIST_MIN_CGPA - 0.01).toFixed(2) + ').';\n  } else {\n    status = 'Not Eligible';\n    notes = 'CGPA below ' + REVIEW_MIN_CGPA + '.';\n  }\n\n  out.push({\n    json: {\n      ...row,\n      applicant_name: name || 'Applicant',\n      applicant_email: email,\n      cgpa_parsed: isNaN(cgpa) ? null : cgpa,\n      degree,\n      valid,\n      Status: status,\n      Notes: notes,\n    },\n  });\n}\n\nreturn out;\n"
      },
